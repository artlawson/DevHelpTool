# Anthropic API key used for the tool-calling orchestration loop
ANTHROPIC_API_KEY=

# Jira Cloud instance base URL, e.g. https://your-domain.atlassian.net
JIRA_BASE_URL=
# Email address of the Jira account associated with the API token
JIRA_EMAIL=
# Jira API token (Basic Auth), created at id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Jira project key, e.g. AL - scopes board/sprint lookups to your project
JIRA_PROJECT_KEY=

# Fine-grained GitHub personal access token, scoped to the repos you want monitored
GITHUB_TOKEN=
# GitHub username used to build author:/review-requested: search queries
GITHUB_USERNAME=
# Optional - "owner/repo" (e.g. artlawson/DevHelpTool) to search for the digest's "PRs
# you could review" section. Leave unset to skip that search entirely.
GITHUB_REPO=

# Optional - Slack integration. Leave unset to run without Slack (default).
# Bot token (xoxb-...) from your Slack app's OAuth & Permissions page
SLACK_BOT_TOKEN=
# App-level token (xapp-...) from Basic Information > App-Level Tokens (Socket Mode)
SLACK_APP_TOKEN=
# Channel or DM ID the daily digest posts to
SLACK_CHANNEL_ID=
